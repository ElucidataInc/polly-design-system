{
  "base": {
    "background": "transparent",
    "borderradius": "0 0 0.375rem 0.375rem",
    "color": "{color.primary.neutral}",
    "gap": "0.5rem",
    "justifycontent": "center",
    "padding": "0.5625rem 0.75rem",
    "position": "relative"
  },
  "size": {
    "small": {
      "padding": "0.3125rem 0.625rem"
    }
  },
  "navbutton": {
    "borderradius": "0 0 0.375rem 0.375rem",
    "height": "3rem",
    "margin": "0",
    "minwidth": "fit-content",
    "padding": "0",
    "transition": "background-color 0.3s ease-out",
    "background": {
      "default": "transparent",
      "hover": "{color.neutral.purple|mix:10:white}",
      "active": "{color.neutral.purple|mix:25:white}",
      "disabled": "{color.primary.neutral|mix:5:white}"
    },
    "color": {
      "default": "{color.primary.neutral|mix:90:white}",
      "active": "{color.neutral.purple|mix:80:black}",
      "disabled": "{color.primary.neutral|mix:60:white}"
    }
  },
  "pageselected": {
    "background": "{color.secondary.purple|mix:10:white}",
    "border": "1px solid {color.secondary.purple|mix:20:white}",
    "color": "{color.secondary.purple|mix:80:black}",
    "transition": "background-color 0.3s ease-out"
  },
  "pages": {
    "gap": "0.5rem"
  },
  "current": {
    "alignitems": "center",
    "backgroundcolor": "transparent",
    "border": "0 none",
    "color": "{color.primary.neutral}",
    "display": "flex",
    "height": "2.286em",
    "margin": "0",
    "minwidth": "2.286em",
    "order": "1",
    "padding": "0 0.5em",
    "right": "0.75rem"
  },
  "sidezone": {
    "margin": "0",
    "position": "absolute",
    "top": "50%",
    "transform": "translateY(-50%)"
  },
  "rppdropdown": {
    "left": "0.75rem"
  },
  "contentstart": {
    "color": "{color.primary.neutral}",
    "left": "5.5rem",
    "whitespace": "nowrap"
  }
}
